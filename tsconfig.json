{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],

    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,

    "noEmit": true,

    "esModuleInterop": true,

    "module": "esnext",
    "moduleResolution": "bundler",

    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "preserve",

    "incremental": true,

    "baseUrl": ".",

    "ignoreDeprecations": "6.0",

    "paths": {
      "@repo/schemas": [
        "packages/schemas/src"
      ],

      "@repo/shared": [
        "packages/shared/src"
      ],

      "@repo/orchestrator": [
        "packages/orchestrator/src"
      ],

      "@repo/workers": [
        "packages/workers/src"
      ],

      "@repo/memory": [
        "packages/memory/src"
      ],

      "@repo/ai": [
        "packages/ai/src"
      ]
    }
  }
}